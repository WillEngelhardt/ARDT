<script>
import { resolveSrc } from "astro/assets/utils";

    function setupGallery() {
      console.log("ASDFASDFLJAEWFOIJ")
        const mainImage = document.getElementById(
            "main-product-image",
        ) as HTMLImageElement;
        const thumbnailBtns = document.querySelectorAll(".thumbnail-btn");

        thumbnailBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const newSrc = btn.getAttribute("data-image");
                //if (newSrc && mainImage) {  
                if (newSrc != null) {
                  console.log(newSrc)
                  mainImage.animate({
                    opacity: 0,
                  }, {
                    duration: 200,
                  }).addEventListener("finish", function(){
                    mainImage.src = newSrc;
                    mainImage.animate({
                      opacity: 0
                    }, {duration: 200, direction: "reverse", easing: "ease-in-out"}).addEventListener("finish", function(){

                    })
                  })

                    // Update active state
                    thumbnailBtns.forEach((b) => {
                        b.classList.remove(
                            "border-primary",
                            "bg-white",
                            "ring-4",
                            "ring-primary/10",
                        );
                        b.classList.add("border-slate-100", "bg-slate-50");
                    });

                    btn.classList.add(
                        "border-primary",
                        "bg-white",
                        "ring-4",
                        "ring-primary/10",
                    );
                    btn.classList.remove("border-slate-100", "bg-slate-50");
               // }
                  }
            });
        });

        // Mark first thumbnail as active initially
        if (thumbnailBtns[thumbnailBtns.length - 1]) {
            thumbnailBtns[thumbnailBtns.length - 1].classList.add(
                "border-primary",
                "bg-white",
                "ring-4",
                "ring-primary/10",
            );
            thumbnailBtns[thumbnailBtns.length - 1].classList.remove(
                "border-slate-100",
                "bg-slate-50",
            );
        }
    }

    // Initialize on page load and on view transitions
    setupGallery();
    document.addEventListener("astro:page-load", setupGallery);
</script>