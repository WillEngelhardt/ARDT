---
import type { CollectionEntry } from "astro:content";
import ArtistCard from "./ArtistCard.astro";
import MediumsCard from "./MediumsCard.astro";
import { getCollection } from "astro:content";

type Props = {
  artists: CollectionEntry<"artists">[];
};

const { artists } = Astro.props;
const grid = "artists";
const pieces = await getCollection("artists");

const mediums = ["Watercolor", "Oil", "Acrylic", "Digital", "Gouache", "Other"];
const portfolio = ["Paintings", "Illustrations", "Sculptures and Functional Ware", "Printmaking", "Digital"];
for (let i = portfolio.length-1; i >= 0; i--) {
  // first test if mediums[i] is a valid property in the data of any piece
  if ((!pieces.some((piece) => piece.data.hasOwnProperty(portfolio[i]))) ||
      (pieces.filter((piece) => piece.data[portfolio[i]] == 1.0).length === 0)) {
    // removes medium if not a property
    portfolio.splice(i, 1);
  }
}
---

<section class="artist-grid SectionGrid" id="grid" data-grid={grid}>
  {portfolio.map((medium) => <MediumsCard title={medium} pieces={
    pieces.filter((piece) => piece.data[medium] == 1.0)
  } />)}
</section>


