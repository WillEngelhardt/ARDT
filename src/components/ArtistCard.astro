---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  artist: CollectionEntry<"artists">;
};

const { artist } = Astro.props;
---

<a
  href={`/${artist.id}`}
  class="artist"
  style={`--image: url('${artist.data.image.src}'); aspect-ratio: ${artist.data.aspectRatio};`}
  data-stagename={artist.data.name}
  data-name={artist.data.Materials}
  data-genre={artist.data.Date}
  data-astro-prefetch
  aria-label={artist.data.name}></a>


<style>
  a {
    background-image: var(--image);
    background-size: cover;
    background-position: 50% 0%;
    aspect-ratio: 1;
  }
  img {
    max-width: 100%;
  }
</style>
