---
import type { CollectionEntry } from "astro:content";
import MediumsCard from "../components/MediumsCard.astro";
import YearCard from "../components/YearCard.astro"
import { getCollection } from "astro:content";

type Props = {
  artists: CollectionEntry<"artists">[];
};

const { artists } = Astro.props;
const grid = "artists";
const pieces = await getCollection("artists");

const mediums = ["Watercolor", "Oil", "Acrylic", "Digital", "Gouache", "Other"];
const portfolio = ["Paintings", "Illustrations", "Ceramic", "Printmaking", "Digital"];
for (let i = portfolio.length-1; i >= 0; i--) {
  // first test if mediums[i] is a valid property in the data of any piece
  if ((!pieces.some((piece) => piece.data.hasOwnProperty(portfolio[i]))) ||
      (pieces.filter((piece) => piece.data[portfolio[i]] == 1.0).length === 0)) {
    // removes medium if not a property
    portfolio.splice(i, 1);
  }
}
const uniqueYears = new Set(pieces.map((piece) => piece.data.Date));
//order set in descending years
const sortedYears = Array.from(uniqueYears).sort((a, b) => b - a);
console.log(uniqueYears);
---

<section class="artist-grid" id="grid" data-grid={grid}>
  {Array.from(sortedYears).map((year) => <YearCard title={year} pieces={
    pieces.filter((piece) => piece.data.Date === year)
  } />)}
</section>


<style>
  section {
    position: relative;
    overflow: hidden;
    display: grid;
    width: 100%;
    grid-template-columns: repeat(1, calc(100% / 1));
    margin: 1rem 0 10rem;
    min-height: 400px;
    @media screen and (min-width: 30em) {
      grid-template-columns: repeat(2, calc(100% / 2));
    }
    @media screen and (min-width: 50em) {
      grid-template-columns: repeat(3, calc(100% / 3));
    }
  }
</style>
