---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";
import { Image } from "astro:assets";

// Get the current pathname
const currentPath = Astro.url.pathname;
// Define a map of routes
const routes = {
  "/": "Home",
  "/releases/": "Releases",
  "/store/": "Store",
  "/history/": "History",
  "/contact/": "Contact",
};
// Determine the active route
const activeRoute = null;//routes[currentPath] || null;

import img1 from '/src/assets/IMG_3093.png';
import img2 from '/src/assets/IMG_3096.png';
---
<header>
  <ul>
  <a href="/" class={activeRoute === "Home" ? "current" : ""} style="max-height: 90px;">
  <Image 
    src={img1}
    alt="asdf"
    width="150"
    height="150" fit='contain' 
    style="max-height: 80px;"
  />
  </a>
  <a href="/" class={activeRoute === "Home" ? "current" : ""} style="max-height: 120px;">
  <Image src={img2} alt="Emily Engelhardt" fit='contain' style="max-height: 70px;"
    />
  </a>
  </ul>
  <!-- <h1>
    <a href="/" class={activeRoute === "Home" ? "current" : ""}
    style="--image: url(/src/assets/IMG_3093.png);"
      ><TextSlider content="ARDT of Emily" /></a>
  </h1> -->
  <span/>
  <ul>
    <!-- <li>
      <a
        href="/recents/"
        class={activeRoute === "Recent work" ? "current" : ""}
        data-astro-prefetch><TextSlider content="Recent work" /></a>
    </li> -->
    <li>
      <a
        href="/portfolio/"
        class={activeRoute === "Mediums" ? "current" : ""}
        data-astro-prefetch><TextSlider content="Portfolio" /></a>
    </li>
    <li>
      <a
        href="https://www.etsy.com/shop/ardtofemily"
        target="_blank"
        data-astro-prefetch><TextSlider content="Store" /></a>
    </li>
    <!-- <li>
      <a
        href="/history/"
        class={activeRoute === "History" ? "current" : ""}
        data-astro-prefetch><TextSlider content="History" /></a>
    </li> -->
    <!-- <li>
      <a
        href="/store/"
        class={activeRoute === "Store" ? "current" : ""}
        data-astro-prefetch><TextSlider content="Store" /></a>
    </li> -->
    <li>
      <a
        href="/contact/"
        class={activeRoute === "Contact" ? "current" : ""}
        data-astro-prefetch><TextSlider content="Contact" /></a>
    </li>
  </ul>
</header>
<Separator />

<style>

  header {
    /* position: sticky; */
    top: 0;
    z-index: 999;
    /* -webkit-text-stroke: 1px;
    -webkit-text-stroke-color: white; */
    text-shadow: -10px -10px 1 #ffffff;

    display: grid;
    /* grid-template-columns: max-content auto auto auto auto; */
    grid-template-columns: min-content auto auto;
    font-weight: 700;
    padding: 1rem 0;
    padding-bottom: 0;
    gap: 1rem;
    align-items: center;
    font-size: 20px;
    justify-items: center;
    justify-content: center;
  }
  header a.current {
    pointer-events: none;
  }
  header img {
    width: fit-content;
  }
  h1 {
    font-size: 1rem;
    font-weight: inherit;
    margin: 0;
  }
  ul {
    display: flex;
    list-style: none;
    gap: 1rem;
    margin: 0;
    padding: 0;
    grid-column: auto / span 2;
  }
  @media screen and (min-width: 60em) {
    header {
      grid-template-columns: max-content auto auto auto auto;
      justify-items: left;
      justify-content: space-between;
    }
  }
</style>
