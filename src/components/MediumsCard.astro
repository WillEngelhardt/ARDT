---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  title: String;
  pieces: CollectionEntry<"artists">[];
};

const { title, pieces } = Astro.props;

const keyPieces = pieces.filter((piece) => piece.data.KeyFrame == 1);
console.log(keyPieces)
const ind: number = Math.floor(Math.random() * keyPieces.length);
//go directly to newest year
const destination = (title === "Paintings") ? "2026" : title;
---
<div class="sectionCard">
<a href={`/${destination}`} class="header">{title}</a>
<a
  href={`/${destination}`}
  style={`--image: url('${keyPieces[ind].data.image.src}');`}
  class="artist"
  >
</a>
</div>

<style>
  .artist {
    background-image: var(--image);
    background-size: cover;
    background-position: 50% 0%;
    aspect-ratio: 0.8;
    font-size: xx-large;
    font-weight: bold;
    display: flex;
    text-align: center;
    justify-content: center;
    
  }
  .header {
    font-size: xx-large;
    font-weight: bold;
    display: flex;
    text-align: center;
    justify-content: center;
  }
</style>
