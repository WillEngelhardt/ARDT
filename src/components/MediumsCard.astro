---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  title: String;
  pieces: CollectionEntry<"artists">[];
};

const { title, pieces } = Astro.props;

const myPieces = pieces
const ind: number = Math.floor(Math.random() * myPieces.length);
---

<a
  href={`/${title}`}
  style={`--image: url('${myPieces[ind].data.image.src}');`}
  class="artist"
  
  >
{title}
</a>


<style>
  a {
    background-image: var(--image);
    background-size: cover;
    background-position: 50% 0%;
    aspect-ratio: 0.8;
    font-size: xx-large;
    font-weight: bold;
    font
    
  }
</style>
